# Copy this file to .env. Never commit .env or paste its values into workflow JSON.

# Rotate neither value casually: changing it makes saved n8n credentials unreadable.
# Generate once with: powershell -File scripts/New-Secrets.ps1
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Used only for gateway administrative reset operations. Inference stays private on
# the Compose network and has no host port.
GATEWAY_ADMIN_TOKEN=replace-with-a-separate-random-token

# ComfyUI runs natively on Windows. Keep this hostname when using Docker Desktop.
COMFY_URL=http://host.docker.internal:8188

# Four input folders are deliberately separate so no cloud classifier is needed.
DRIVE_METAL_UNPRINTED_INPUT_ID=replace-with-drive-folder-id
DRIVE_METAL_PRINTED_INPUT_ID=replace-with-drive-folder-id
DRIVE_METAL_REVISION_UNPRINTED_INPUT_ID=replace-with-drive-folder-id
DRIVE_METAL_REVISION_PRINTED_INPUT_ID=replace-with-drive-folder-id

# Existing output and Done folders remain shared by printed/unprinted inputs.
DRIVE_METAL_OUTPUT_ID=replace-with-drive-folder-id
DRIVE_METAL_DONE_ID=replace-with-drive-folder-id
DRIVE_METAL_REVISION_OUTPUT_ID=replace-with-drive-folder-id
DRIVE_METAL_REVISION_DONE_ID=replace-with-drive-folder-id
